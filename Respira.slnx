    <Project Path="src/Respira.AppHost/Respira.AppHost.csproj" />
    <Project Path="src/Respira.Clinical/Infrastructure/Respira.Clinical.Infrastructure.csproj" />
    <Project Path="src/Respira.Gateway/Respira.Gateway.csproj" />
    <Project Path="src/Respira.Patient/API/Respira.Patient.API.csproj" />
    <Project Path="src/Respira.Patient/Application/Respira.Patient.Application.csproj" />
    <Project Path="src/Respira.Patient/DI/Respira.Patient.DI.csproj" />
    <Project Path="src/Respira.Patient/Domain/Respira.Patient.Domain.csproj" />
    <Project Path="src/Respira.Patient/Infrastructure/Respira.Patient.Infrastructure.csproj" />

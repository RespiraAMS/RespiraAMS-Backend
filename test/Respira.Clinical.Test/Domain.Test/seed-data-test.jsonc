            "riskFactors": []
        },
        {
            "id": "00000000-0000-0000-0000-500000000027",
            "name": "Metapneumovirus",
            "description": "Respiratory virus",
            "isAtypical": false,
            "riskFactors": []
        },
        {
            "id": "00000000-0000-0000-0000-500000000028",
            "name": "Human metapneumovirus (HMPV)",
            "description": "Respiratory virus",
            "isAtypical": false,
            "riskFactors": []
        },
        {
            "id": "00000000-0000-0000-0000-500000000029",
            "name": "Cytomegalovirus (CMV)",
            "description": "Respiratory virus",
            "isAtypical": false,
            "riskFactors": []
        },
        {
            "id": "00000000-0000-0000-0000-500000000030",
            "name": "Epstein-Barr virus (EBV)",
            "description": "Respiratory virus",
            "isAtypical": false,
            "riskFactors": []
        }

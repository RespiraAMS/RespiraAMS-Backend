    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Authentication.Domain/Respira.Authentication.Domain.csproj" />
        <ProjectReference Include="../Authentication.Application/Respira.Authentication.Application.csproj" />
    </ItemGroup>

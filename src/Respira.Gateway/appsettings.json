{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/1/auth/{**catch-all}"
        }
      },
      "doctor-route": {
        "ClusterId": "doctor-cluster",
        "Match": {
          "Path": "/api/1/doctors/{**catch-all}"
        }
      },
      "antibiograms-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/antibiograms/{**catch-all}"
        }
      },
      "antibiotic-groups-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/antibiotic-groups/{**catch-all}"
        }
      },
      "antibiotics-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/antibiotics/{**catch-all}"
        }
      },
      "causes-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/causes/{**catch-all}"
        }
      },
      "diagnose-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/diagnose/{**catch-all}"
        }
      },
      "diseases-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/diseases/{**catch-all}"
        }
      },
      "empiric-treatment-protocols-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/empiric-treatment-protocols/{**catch-all}"
        }
      },
      "icu-hospitalize-criteria-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/icu-hospitalize-criteria/{**catch-all}"
        }
      },
      "pathogens-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/pathogens/{**catch-all}"
        }
      },
      "resistance-risk-factors-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/1/resistance-risk-factors/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/1/media/{**catch-all}"
        }
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/1/patients/{**catch-all}"
        }
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/1/analytics/{**catch-all}"
        }
      },
      "saga-root-route": {
        "ClusterId": "saga-cluster",
        "Match": {
          "Path": "/api/1/sagas"
        }
      },
      "saga-route": {
        "ClusterId": "saga-cluster",
        "Match": {
          "Path": "/api/1/sagas/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "doctor-cluster": {
        "Destinations": {
          "doctor": {
            "Address": "http://doctor-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "clinical-cluster": {
        "Destinations": {
          "clinical": {
            "Address": "http://clinical-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "media-cluster": {
        "Destinations": {
          "media": {
            "Address": "http://media-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:02:00"
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient": {
            "Address": "http://patient-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics": {
            "Address": "http://analytics-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "saga-cluster": {
        "Destinations": {
          "saga": {
            "Address": "http://saga-audit-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:01:00"
        }
      }
    }
  }
}

{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "auth-route": {
                "ClusterId": "auth-cluster",
                "Match": {
                    "Path": "/api/v1/auth/{**catch-all}"
                }
            },
            "doctor-route": {
                "ClusterId": "doctor-cluster",
                "Match": {
                    "Path": "/api/v1/doctors/{**catch-all}"
                }
            },
            "media-route": {
                "ClusterId": "media-cluster",
                "Match": {
                    "Path": "/api/v1/media/{**catch-all}"
                }
            },
            "saga-route": {
                "ClusterId": "saga-cluster",
                "Match": {
                    "Path": "/api/v1/sagas/{**catch-all}"
                }
            },
            "antibiotic-groups-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/antibiotic-groups/{**catch-all}"
                }
            },
            "antibiotics-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/antibiotics/{**catch-all}"
                }
            },
            "suspected-causes-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/suspected-causes/{**catch-all}"
                }
            },
            "diagnose-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/diagnose/{**catch-all}"
                }
            },
            "pathogens-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/pathogens/{**catch-all}"
                }
            },
            "clinical-variables-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/clinical-variables/{**catch-all}"
                }
            },
            "criteria-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/criteria/{**catch-all}"
                }
            },
            "risk-factors-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/risk-factors/{**catch-all}"
                }
            },
            "clinical-metrics-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/v1/clinical-metrics/{**catch-all}"
                }
            },
            "patient-patients-route": {
                "ClusterId": "patient-cluster",
                "Match": {
                    "Path": "/api/v1/patients/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "clinical-cluster": {
                "Destinations": {
                    "clinical": {
                        "Address": "http://clinical-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            },
            "patient-cluster": {
                "Destinations": {
                    "patient": {
                        "Address": "http://patient-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            },
            "saga-cluster": {
                "Destinations": {
                    "saga": {
                        "Address": "http://saga-audit-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:01:00"
                }
            },
            "media-cluster": {
                "Destinations": {
                    "media": {
                        "Address": "http://media-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:02:00"
                }
            },
            "auth-cluster": {
                "Destinations": {
                    "auth": {
                        "Address": "http://auth-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            },
            "doctor-cluster": {
                "Destinations": {
                    "doctor": {
                        "Address": "http://doctor-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            },
        }
    }
}

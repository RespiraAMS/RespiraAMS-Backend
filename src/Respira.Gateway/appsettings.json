{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ReverseProxy": {
        "Routes": {
            "antibiotic-groups-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/antibiotic-groups/{**catch-all}"
                }
            },
            "antibiotics-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/antibiotics/{**catch-all}"
                }
            },
            "suspected-causes-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/suspected-causes/{**catch-all}"
                }
            },
            "diagnose-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/diagnose/{**catch-all}"
                }
            },
            "pathogens-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/pathogens/{**catch-all}"
                }
            },
            "clinical-variables-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/clinical-variables/{**catch-all}"
                }
            },
            "criteria-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/criteria/{**catch-all}"
                }
            },
            "risk-factors-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/risk-factors/{**catch-all}"
                }
            },
            "clinical-metrics-route": {
                "ClusterId": "clinical-cluster",
                "Match": {
                    "Path": "/api/1/clinical-metrics/{**catch-all}"
                }
            },
            "patient-patients-route": {
                "ClusterId": "patient-cluster",
                "Match": {
                    "Path": "/api/1/patients/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "clinical-cluster": {
                "Destinations": {
                    "clinical": {
                        "Address": "http://clinical-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            },
            "patient-cluster": {
                "Destinations": {
                    "patient": {
                        "Address": "http://patient-service"
                    }
                },
                "HttpRequest": {
                    "Timeout": "00:00:30"
                }
            }
        }
    }
}

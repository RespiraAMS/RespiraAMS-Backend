{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "doctor-route": {
        "ClusterId": "doctor-cluster",
        "Match": {
          "Path": "/api/v1/doctors/{**catch-all}"
        }
      },
      "clinical-route": {
        "ClusterId": "clinical-cluster",
        "Match": {
          "Path": "/api/v1/clinical/{**catch-all}"
        }
      },
      "media-route": {
        "ClusterId": "media-cluster",
        "Match": {
          "Path": "/api/v1/media/{**catch-all}"
        }
      },
      "patient-route": {
        "ClusterId": "patient-cluster",
        "Match": {
          "Path": "/api/v1/patients/{**catch-all}"
        }
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/api/v1/analytics/{**catch-all}"
        }
      },
      "saga-route": {
        "ClusterId": "saga-cluster",
        "Match": {
          "Path": "/api/v1/sagas/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "doctor-cluster": {
        "Destinations": {
          "doctor": {
            "Address": "http://doctor-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "clinical-cluster": {
        "Destinations": {
          "clinical": {
            "Address": "http://clinical-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "media-cluster": {
        "Destinations": {
          "media": {
            "Address": "http://media-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:02:00"
        }
      },
      "patient-cluster": {
        "Destinations": {
          "patient": {
            "Address": "http://patient-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics": {
            "Address": "http://analytics-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:00:30"
        }
      },
      "saga-cluster": {
        "Destinations": {
          "saga": {
            "Address": "http://saga-audit-service"
          }
        },
        "HttpRequest": {
          "Timeout": "00:01:00"
        }
      }
    }
  }
}

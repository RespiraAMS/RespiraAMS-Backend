{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Aspire.Hosting.Dcp": "Warning"
        }
    },
    "Parameters": {
        "jwt-secret": "dev-only-secret-key-change-in-production-0123456789abcdef8OA1AhnEtVcacz62Qm0SlACdX5IXw==",
        "email-user-name": "YOUR-EMAIL",
        "email-password": "YOUR-APP-PASSWORD",
        "r2-access-key": "YOUR-R2-ACCESS-KEY",
        "r2-secret-key": "YOUR-R2-SECRET-KEY"
    },
    "Shared": {
        "Jwt": {
            "Issuer": "Respira AMS",
            "Audience": "respira-clients",
            "AccessTokenExpires": 60,
            "RefreshTokenExpires": 7
        },
        "Email": {
            "Host": "smtp.gmail.com",
            "Port": 465,
            "FromEmail": "YOUR-EMAIL",
            "FromName": "Respira",
            "UseSsl": true
        },
        "EmailVerification": {
            "ConfirmUrl": "<YOUR-FRONTEND-URL>/verify-email",
            "TokenExpiresHours": 24
        },
        "PasswordReset": {
            "ResetUrl": "<YOUR-FRONTEND-URL>/reset-password",
            "TokenExpiresHours": 1
        },
        "R2": {
            "Endpoint": "YOUR-R2-ENDPOINT",
            "BucketName": "avatar",
            "PublicUrl": "YOUR-R2-PUBLIC-URL"
        },
        "ClinicalSeedData": {
            "FilePath": "Data/seed-data.jsonc"
        },
        "CORS": {
            "AllowedOrigins": [
                "<YOUR-FRONTEND-URL>"
            ],
            "AllowedMethods": [
                "GET",
                "POST",
                "PUT",
                "DELETE",
                "PATCH",
                "OPTIONS"
            ],
            "AllowedHeaders": [
                "Content-Type",
                "Authorization",
                "X-Requested-With",
                "X-ID",
                "X-Email",
                "X-Role"
            ]
        }
    }
}

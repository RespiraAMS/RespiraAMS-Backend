    // Shared criteria that can be reused
    "criteria": [
        // CURB-65 criteria
        {
            "id": "00000000-0000-0000-0000-400000000001",
            "name": "Has confusion",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Boolean",
                    "variable": {
                        "id": "00000000-0000-0000-0000-100000000005"
                    }
                },
                "right": {
                    "resultType": "Boolean",
                    "constant": true
                },
                "operator": "EQ"
            }
        },
        {
            "id": "00000000-0000-0000-0000-400000000002",
            "name": "Uremia > 7 mmol/L",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Numeric",
                    "variable": {
                        "id": "00000000-0000-0000-0000-100000000010"
                    }
                },
                "right": {
                    "resultType": "Numeric",
                    "constant": 7
                },
                "operator": "GT"
            }
        },
        // This is a custom criteria of CURB-65, it's not wrong, our stakeholders required that
        {
            "id": "00000000-0000-0000-0000-400000000003",
            "name": "Respiratory rate > 30 or SpO2 < 90%",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Boolean",
                    "left": {
                        "resultType": "Numeric",
                        "variable": {
                            "id": "00000000-0000-0000-0000-100000000006"
                        }
                    },
                    "right": {
                        "resultType": "Numeric",
                        "constant": 30
                    },
                    "operator": "GT"
                },
                "right": {
                    "resultType": "Boolean",
                    "left": {
                        "resultType": "Numeric",
                        "variable": {
                            "id": "00000000-0000-0000-0000-100000000015"
                        }
                    },
                    "right": {
                        "resultType": "Numeric",
                        "constant": 90
                    },
                    "operator": "LT"
                },
                "operator": "OR"
            }
        },
        {
            "id": "00000000-0000-0000-0000-400000000004",
            "name": "Low blood pressure",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Boolean",
                    "left": {
                        "resultType": "Numeric",
                        "variable": {
                            "id": "00000000-0000-0000-0000-100000000007"
                        }
                    },
                    "right": {
                        "resultType": "Numeric",
                        "constant": 90
                    },
                    "operator": "LT"
                },
                "right": {
                    "resultType": "Boolean",
                    "left": {
                        "resultType": "Numeric",
                        "variable": {
                            "id": "00000000-0000-0000-0000-100000000008"
                        }
                    },
                    "right": {
                        "resultType": "Numeric",
                        "constant": 60
                    },
                    "operator": "LTE"
                },
                "operator": "OR"
            }
        },
        {
            "id": "00000000-0000-0000-0000-400000000005",
            "name": "Age > 65",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Numeric",
                    "variable": {
                        "id": "00000000-0000-0000-0000-100000000001"
                    }
                },
                "right": {
                    "resultType": "Numeric",
                    "constant": 65
                },
                "operator": "GTE"
            }
        },
        // IDSA/ATS criteria
        {
            "id": "00000000-0000-0000-0000-400000000006",
            "name": "Respiratory failure requiring mechanical ventilation",
            "formula": {
                "resultType": "Boolean",
                "left": {
                    "resultType": "Boolean",
                    "variable": {
                        "id": "00000000-0000-0000-0000-100000000019"
                    }
                },
                "right": {
                    "resultType": "Boolean",
                    "constant": true
                },

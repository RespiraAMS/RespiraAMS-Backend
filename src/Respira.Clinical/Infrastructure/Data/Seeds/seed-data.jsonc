{
    "pathogens": [
        {
            "id": "00000000-0000-0000-0000-000000000101",
            "name": "Chlamydia pnuemoniae",
            "description": "Chlamydia pneumoniae là một loại vi khuẩn nội bào bắt buộc gây nhiễm trùng đường hô hấp ở người như viêm họng, viêm phế quản và viêm phổi không điển hình"
        },
        {
            "id": "00000000-0000-0000-0000-000000000102",
            "name": "Haemophilus influenzae",
            "description": "Haemophilus influenzae là một loài trực khuẩn Gram-âm, ký sinh chủ yếu ở đường hô hấp trên của người và có khả năng gây ra nhiều bệnh nhiễm trùng cấp tính nguy hiểm"
        },
        {
            "id": "00000000-0000-0000-0000-000000000103",
            "name": "Legionella spp",
            "description": "Legionella spp. (các loài Legionella) là một chi trực khuẩn Gram-âm, ký sinh nội bào bắt buộc, thường cư trú trong môi trường nước và là tác nhân gây ra bệnh nhiễm trùng hô hấp cấp tính nghiêm trọng ở người."
        },
        {
            "id": "00000000-0000-0000-0000-000000000104",
            "name": "Mycoplasma pneumoniae",
            "description": "Mycoplasma pneumoniae là một loại vi khuẩn đặc biệt gây nhiễm trùng đường hô hấp, là tác nhân hàng đầu dẫn đến bệnh \"viêm phổi không điển hình\" (atypical pneumonia) ở trẻ em và người trẻ tuổi."
        },
        {
            "id": "00000000-0000-0000-0000-000000000105",
            "name": "Pseudomonas aeruginosae",
            "description": "Pseudomonas aeruginosa (Trực khuẩn mủ xanh) là một loài vi khuẩn Gram-âm hình que, có khả năng di động và là một trong những tác nhân gây nhiễm trùng bệnh viện (nosocomial infections) nguy hiểm nhất hiện nay"
        },
        {
            "id": "00000000-0000-0000-0000-000000000106",
            "name": "Staphylococus aureus",
            "description": "Staphylococcus aureus (Tụ cầu vàng) là một loài cầu khuẩn Gram-dương, xếp thành hình chùm nho, gây ra phần lớn các ca nhiễm trùng da và mô mềm cả trong cộng đồng lẫn bệnh viện."
        },
        {
            "id": "00000000-0000-0000-0000-000000000107",
            "name": "Streptococcus pneumoniae",
            "description": "Streptococcus pneumoniae (Phế cầu khuẩn) là một loài cầu khuẩn Gram-dương, xếp thành cặp hình ngọn giáo (song cầu), là tác nhân hàng đầu gây ra các bệnh nhiễm trùng hô hấp và xâm lấn nguy hiểm ở trẻ em dưới 5 tuổi và người cao tuổi"
        },
        {
            "id": "00000000-0000-0000-0000-000000000108",
            "name": "Vi khuẩn gram âm đường ruột",
            "description": "Vi khuẩn Gram-âm đường ruột (chủ yếu thuộc họ Enterobacteriaceae) là nhóm các trực khuẩn cư trú tự nhiên hoặc gây bệnh trong ống tiêu hóa của người và động vật."
        },
        {
            "id": "00000000-0000-0000-0000-000000000109",
            "name": "Virus hô hấp",
            "description": "Virus hô hấp là nhóm các virus tấn công vào niêm mạc đường thở của con người, gây ra các tổn thương từ thể nhẹ như cảm lạnh thông thường đến các biến chứng nguy hiểm tính mạng như viêm phổi cấp, suy hô hấp"
        }
    ],
    "antibioticGroups": [
        {
            "id": "00000000-0000-0000-0000-000000000201",
            "name": "Beta-lactam",
            "description": "Họ kháng sinh lớn nhất, có cấu trúc hóa học chứa vòng beta-lactam. Gồm các phân nhóm: penicilin, cephalosporin và các beta-lactam khác (carbapenem, monobactam, chất ức chế beta-lactamase). ADR đặc trưng: dị ứng (có thể sốc phản vệ), tai biến thần kinh, rối loạn tiêu hóa.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-000000000202",
            "name": "Penicilin",
            "description": "Dẫn xuất của acid 6-aminopenicilanic. Chỉ có penicilin G là tự nhiên, còn lại là bán tổng hợp. Chia thành 4 phân nhóm theo phổ kháng khuẩn: phổ hẹp (penicilin G, V), phổ hẹp có tác dụng trên tụ cầu (methicilin, oxacilin...), phổ trung bình (ampicilin, amoxicilin), phổ rộng có tác dụng trên trực khuẩn mủ xanh (carbenicilin, piperacilin...).",
            "parentId": "00000000-0000-0000-0000-000000000201"
        },
        {
            "id": "00000000-0000-0000-0000-000000000203",
            "name": "Cephalosporin",
            "description": "Dẫn xuất của acid 7-aminocephalosporanic, bán tổng hợp, chia thành 4 thế hệ dựa trên phổ kháng khuẩn. Từ thế hệ 1 đến 4, hoạt tính trên Gram-dương giảm dần và trên Gram-âm tăng dần. Hầu như không có tác dụng trên enterococci, Listeria, S. aureus kháng methicilin.",
            "parentId": "00000000-0000-0000-0000-000000000201"
        },
        {
            "id": "00000000-0000-0000-0000-000000000204",
            "name": "Các beta-lactam khác",
            "description": "Nhóm bao gồm carbapenem, monobactam và các chất ức chế beta-lactamase, được tạo ra từ biến đổi cấu trúc của penicilin/cephalosporin.",
            "parentId": "00000000-0000-0000-0000-000000000201"
        },
        {
            "id": "00000000-0000-0000-0000-000000000205",
            "name": "Carbapenem",
            "description": "Phổ kháng khuẩn rất rộng, hoạt tính mạnh trên vi khuẩn Gram-âm, cả hiếu khí và kỵ khí. Đại diện: imipenem (cần phối hợp cilastatin), meropenem, doripenem, ertapenem.",
            "parentId": "00000000-0000-0000-0000-000000000204"
        },
        {
            "id": "00000000-0000-0000-0000-000000000206",
            "name": "Monobactam",
            "description": "Chứa beta-lactam đơn vòng, đại diện là aztreonam. Chỉ có tác dụng trên vi khuẩn Gram-âm (mạnh trên Enterobacteriaceae và P. aeruginosa), không có tác dụng trên Gram-dương và kỵ khí.",
            "parentId": "00000000-0000-0000-0000-000000000204"
        },
        {
            "id": "00000000-0000-0000-0000-000000000207",
            "name": "Chất ức chế beta-lactamase",
            "description": "Có cấu trúc beta-lactam nhưng không có hoạt tính kháng khuẩn, chỉ ức chế enzym beta-lactamase của vi khuẩn. Gồm acid clavulanic, sulbactam, tazobactam, thường phối hợp với penicilin phổ trung bình.",
            "parentId": "00000000-0000-0000-0000-000000000204"
        },
        {
            "id": "00000000-0000-0000-0000-000000000208",
            "name": "Aminoglycosid",
            "description": "Kháng sinh tự nhiên hoặc bán tổng hợp (kanamycin, gentamycin, tobramycin, amikacin...), phổ tác dụng chủ yếu trên trực khuẩn Gram-âm. ADR thường gặp: giảm thính lực, suy thận, nhược cơ; chỉ dùng đường tiêm bắp hoặc truyền tĩnh mạch.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-000000000209",
            "name": "Macrolid",
            "description": "Kháng sinh tự nhiên hoặc bán tổng hợp, chia theo cấu trúc 14/15/16 carbon (erythromycin, azithromycin, spiramycin...). Phổ hẹp, chủ yếu trên Gram-dương và một số vi khuẩn nội bào. ADR chính: rối loạn tiêu hóa, viêm gan/ứ mật.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-00000000020a",
            "name": "Lincosamid",
            "description": "Gồm lincomycin (tự nhiên) và clindamycin (bán tổng hợp). Phổ tương tự macrolid trên Gram-dương, nhưng có tác dụng tốt trên vi khuẩn kỵ khí (B. fragilis). ADR đáng chú ý: tiêu chảy, viêm đại tràng giả mạc do C. difficile.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-00000000020b",
            "name": "Phenicol",
            "description": "Gồm cloramphenicol (tự nhiên) và thiamphenicol (tổng hợp). Phổ rộng nhưng tỷ lệ kháng thuốc cao và độc tính nghiêm trọng trên tủy xương (bất sản tủy) nên ít dùng. Có thể gây hội chứng xám ở trẻ sơ sinh.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-00000000020c",
            "name": "Tetracyclin (Cyclin)",
            "description": "Gồm kháng sinh tự nhiên và bán tổng hợp (tetracyclin, doxycyclin, minocyclin...). Phổ rộng trên Gram-âm, Gram-dương, vi khuẩn không điển hình và một số xoắn khuẩn. ADR đặc trưng: gắn vào xương/răng gây hỏng răng ở trẻ nhỏ, mẫn cảm ánh sáng.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-00000000020d",
            "name": "Tetracyclin thế hệ 1",
            "description": "Nhóm tetracyclin thế hệ đầu (chlortetracyclin, oxytetracyclin, demeclocyclin, methacyclin), tỷ lệ kháng thuốc hiện nay cao.",
            "parentId": "00000000-0000-0000-0000-00000000020c"
        },
        {
            "id": "00000000-0000-0000-0000-00000000020e",
            "name": "Tetracyclin thế hệ 2",
            "description": "Gồm doxycyclin và minocyclin, vẫn còn tác dụng trên một số chủng vi khuẩn đã kháng tetracyclin thế hệ 1.",
            "parentId": "00000000-0000-0000-0000-00000000020c"
        },
        {
            "id": "00000000-0000-0000-0000-00000000020f",
            "name": "Peptid",
            "description": "Nhóm kháng sinh có cấu trúc peptid, gồm 3 phân nhóm: glycopeptid, polypeptid và lipopeptid.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-000000000210",
            "name": "Glycopeptid",
            "description": "Gồm vancomycin và teicoplanin, tác dụng chủ yếu trên Gram-dương, dùng điều trị S. aureus kháng methicilin. ADR: viêm tĩnh mạch, hội chứng người đỏ (red-man), độc tính trên tai và thận.",
            "parentId": "00000000-0000-0000-0000-00000000020f"
        },
        {
            "id": "00000000-0000-0000-0000-000000000211",
            "name": "Polypeptid",
            "description": "Gồm polymyxin B và colistin, chỉ tác dụng trên trực khuẩn Gram-âm. Độc tính cao trên thận và thần kinh nên chỉ dùng ngoài (polymyxin) hoặc hạn chế trong trường hợp đa kháng (colistin).",
            "parentId": "00000000-0000-0000-0000-00000000020f"
        },
        {
            "id": "00000000-0000-0000-0000-000000000212",
            "name": "Lipopeptid",
            "description": "Đại diện là daptomycin, chiết xuất tự nhiên, tác dụng trên Gram-dương kể cả chủng kháng vancomycin. ADR đặc trưng: tổn thương cơ xương, tăng creatin kinase, hiếm gặp tiêu cơ vân.",
            "parentId": "00000000-0000-0000-0000-00000000020f"
        },
        {
            "id": "00000000-0000-0000-0000-000000000213",
            "name": "Quinolon",
            "description": "Kháng sinh tổng hợp hóa học hoàn toàn, chia thành các thế hệ theo phổ kháng khuẩn (thế hệ 1 và các fluoroquinolon thế hệ 2-4). ADR đặc trưng: viêm gân/đứt gân Asin, ảnh hưởng sụn tiếp hợp ở trẻ em, tác dụng trên thần kinh trung ương.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-000000000214",
            "name": "Quinolon thế hệ 1",
            "description": "Gồm acid nalidixic và cinoxacin, tác dụng trung bình trên trực khuẩn Gram-âm họ Enterobacteriaceae, không có nhóm flo trong cấu trúc.",
            "parentId": "00000000-0000-0000-0000-000000000213"
        },
        {
            "id": "00000000-0000-0000-0000-000000000215",
            "name": "Fluoroquinolon (thế hệ 2, 3, 4)",
            "description": "Các quinolon có flo trong cấu trúc. Thế hệ 2 (norfloxacin, ciprofloxacin...) tập trung trên Gram-âm; thế hệ 3 (levofloxacin, moxifloxacin...) mở rộng thêm trên phế cầu (quinolon hô hấp); thế hệ 4 (trovafloxacin) phổ rộng nhất, bao gồm cả vi khuẩn kỵ khí.",
            "parentId": "00000000-0000-0000-0000-000000000213"
        },
        {
            "id": "00000000-0000-0000-0000-000000000216",
            "name": "Các nhóm kháng sinh khác",
            "description": "Nhóm tổng hợp các kháng sinh không thuộc các họ chính, gồm sulfonamid (co-trimoxazol), oxazolidinon và 5-nitroimidazol.",
            "parentId": null
        },
        {
            "id": "00000000-0000-0000-0000-000000000217",
            "name": "Sulfonamid (Co-trimoxazol)",
            "description": "Phối hợp sulfamethoxazol và trimethoprim, ức chế tổng hợp acid folic của vi khuẩn. Phổ rộng nhưng tỷ lệ kháng thuốc hiện nay cao. ADR đặc trưng: dị ứng nặng (hội chứng Stevens-Johnson, Lyell), độc tính gan thận, thiếu máu tan máu ở người thiếu G6PD.",
            "parentId": "00000000-0000-0000-0000-000000000216"
        },
        {
            "id": "00000000-0000-0000-0000-000000000218",
            "name": "Oxazolidinon",
            "description": "Kháng sinh tổng hợp, đại diện là linezolid, tác dụng trên Gram-dương kể cả chủng đa kháng (kháng vancomycin, kháng methicilin). ADR đáng lưu ý: ức chế tủy xương gây thiếu máu, giảm bạch cầu, giảm tiểu cầu.",
            "parentId": "00000000-0000-0000-0000-000000000216"
        },
        {
            "id": "00000000-0000-0000-0000-000000000219",
            "name": "5-nitro-imidazol",
            "description": "Dẫn xuất tổng hợp hóa học của 5-nitro imidazol (metronidazol, tinidazol, ornidazol...), chỉ định trong điều trị đơn bào và vi khuẩn kỵ khí. ADR: rối loạn tiêu hóa, nước tiểu sẫm màu, tác dụng giống disulfiram nên không dùng cùng rượu.",
            "parentId": "00000000-0000-0000-0000-000000000216"
        }
    ],
